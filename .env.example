# ==============================================================================
# Meridex Solutions - Environment Variables Template
# ==============================================================================
# Add these variables in your Vercel Project Settings > Environment Variables,
# or in .env.local for local testing.
# ==============================================================================

# Google Analytics (GA4 Measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console Verification Token (found in HTML tag verification method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact Form Delivery
CONTACT_RECEIVER_EMAIL=info@meridexsolutions.com

# SMTP Email Configuration (e.g. Brevo / Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
